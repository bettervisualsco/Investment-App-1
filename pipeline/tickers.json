{
  "_howTo": [
    "This is the watchlist. To add an ETF, copy one of the blocks under 'etfs', change id/yahoo/market/currency,",
    "choose its long-run proxy (what it invests in), and add pipeline/etf_info/<id>.json with its facts.",
    "The next pipeline run downloads its full history. ASX symbols end in .AX on Yahoo.",
    "Proxy series you can use: au_shares, us_shares, global_shares, us_tech, au_bonds, us_bonds, cash_au, cash_us.",
    "Weights must add up to 1. 'hedged': true means the part is currency-hedged (no AUD/USD conversion)."
  ],
  "etfs": [
    { "id": "VAS", "yahoo": "VAS.AX", "market": "asx", "currency": "AUD", "proxy": [{ "series": "au_shares", "weight": 1 }] },
    { "id": "VGS", "yahoo": "VGS.AX", "market": "asx", "currency": "AUD", "proxy": [{ "series": "global_shares", "weight": 1 }] },
    { "id": "IVV", "yahoo": "IVV.AX", "market": "asx", "currency": "AUD", "proxy": [{ "series": "us_shares", "weight": 1 }] },
    { "id": "NDQ", "yahoo": "NDQ.AX", "market": "asx", "currency": "AUD", "proxy": [{ "series": "us_tech", "weight": 1 }] },
    { "id": "A200", "yahoo": "A200.AX", "market": "asx", "currency": "AUD", "proxy": [{ "series": "au_shares", "weight": 1 }] },
    {
      "id": "VDHG", "yahoo": "VDHG.AX", "market": "asx", "currency": "AUD",
      "proxy": [
        { "series": "au_shares", "weight": 0.36 },
        { "series": "global_shares", "weight": 0.38 },
        { "series": "global_shares", "weight": 0.16, "hedged": true },
        { "series": "au_bonds", "weight": 0.03 },
        { "series": "us_bonds", "weight": 0.07, "hedged": true }
      ]
    },
    {
      "id": "DHHF", "yahoo": "DHHF.AX", "market": "asx", "currency": "AUD",
      "proxy": [
        { "series": "au_shares", "weight": 0.37 },
        { "series": "global_shares", "weight": 0.63 }
      ]
    },
    { "id": "VAF", "yahoo": "VAF.AX", "market": "asx", "currency": "AUD", "proxy": [{ "series": "au_bonds", "weight": 1 }] },
    { "id": "VOO", "yahoo": "VOO", "market": "us", "currency": "USD", "proxy": [{ "series": "us_shares", "weight": 1 }] },
